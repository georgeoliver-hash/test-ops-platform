        //             { "Type": "JS_SetInputValue", "Value": "${LineId}", "Index": 0 },
        //             { "Type": "JS_KeyPress", "Key": "Enter" }
        //         ]}
        //     }
        // },
        // "TripSetup.Trip": {
        //     "Screen": "TripSetup",
        //     "Navigable_screens": {
        //         // 7.5 Enter Trip Screen: 1-3 digit trip number -> ISSUE.
        //         "TripSetup.BoardingZone": { "Type": "Stages", "Actions": [
        //             { "Type": "JS_SetInputValue", "Value": "${TripNumber}", "Index": 0 },
        //             { "Type": "JS_KeyPress", "Key": "Enter" }
        //         ]}
        //     }
        // },
        // "TripSetup.BoardingZone": {
        //     "Screen": "TripSetup",
        //     "Navigable_screens": {
        //         // 7.6 Enter Boarding Zone Screen: must be a zone on the selected Line.
        //         "TripSetup.AlightingZone": { "Type": "Stages", "Actions": [
        //             { "Type": "JS_SetInputValue", "Value": "${BoardingZone}", "Index": 0 },
        //             { "Type": "JS_KeyPress", "Key": "Enter" }
        //         ]}
        //     }
        // },
        // "TripSetup.AlightingZone": {
        //     "Screen": "TripSetup",
        //     "Navigable_screens": {
        //         // 7.7 Enter Alighting Zone Screen: must be a zone on the selected Line.
