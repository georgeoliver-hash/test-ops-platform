        // Supervisor Menu Screens
        "Supervisor.Menu": {
            "Navigable_screens": {
                "Supervisor.Versions": {"Type": "UI_Button", "Text": "Versions"},
                "Supervisor.HistoricWaybillsList": {"Type": "UI_Button", "Text": "Historic Waybills"},
                "Supervisor.GPSInfo": {"Type": "UI_Button", "Text": "GPS Information"},
                "Supervisor.ForceComms": {"Type": "UI_Button", "Text": "Force Comms"},
                "Supervisor.SoftReboot": {"Type": "UI_Button", "Text":"Soft Reboot"},
                "Supervisor.OtherDevices": {"Type": "UI_Button", "Text":"Other Devices"},
