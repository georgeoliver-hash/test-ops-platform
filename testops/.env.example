# Copy to .env and fill in. .env is gitignored — never commit real credentials.
#
# TestRail integration (read-only). Your API key is generated in TestRail under:
#   My Settings -> API Keys -> Add Key
# TESTRAIL_USER is the email you log in to TestRail with.
TESTRAIL_URL=https://YOURCOMPANY.testrail.io
TESTRAIL_USER=you@arrive.com
TESTRAIL_API_KEY=

# Optional: default TestRail project id (numeric). Find it in the project URL:
#   .../index.php?/projects/overview/<PROJECT_ID>
# TESTRAIL_PROJECT_ID=

# Optional write-back: the ONE suite id the tool is allowed to create cases in (the NEW suite).
# Writes go nowhere unless this is set, and never to any other suite. Old/source suites stay
# strictly read-only. `push` is dry-run unless you pass --commit.
# TESTRAIL_WRITE_SUITE_ID=

# NOTE: JIRA is NOT read through this file. It is read at the agent layer via the
# Atlassian (Rovo) MCP, which each teammate connects with their own account.
# See docs/getting-started.md.

# Optional: local requirement spec library for tools/extract_req.py (see CLAUDE.md "Data sources").
# Full requirement docs are confidential and large — they stay LOCAL, never committed. Point this
# at your own local copy (loose files or .zip bundles); if unset, pass --dir instead.
# REQS_DIR=
