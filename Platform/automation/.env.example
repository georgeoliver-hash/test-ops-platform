# Per-device secrets — names match env_*_var fields in projects/*/devices.yaml
TRANSLINK_TVM_01_PASSWORD=

# BOS — either a static bearer (early bring-up / recorded session)
# OR Keycloak credentials (preferred for real runs).
BOS_BASE_URL=
BOS_API_TOKEN=

# Keycloak realm — usually picked up from devices.yaml `identity_provider_uri`.
# Override here only for ad-hoc runs.
KEYCLOAK_REALM_URI=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_USERNAME=
KEYCLOAK_PASSWORD=

# Appium server (for Android UI driver)
APPIUM_URL=http://127.0.0.1:4723

# Active project (alternative to setting PROJECT inline)
PROJECT=
